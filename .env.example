# Application
ENV=development
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://mdp_user:mdp_pass@postgres:5432/market_diagnosis

# Redis
REDIS_URL=redis://:redis_pass@redis:6379/0

# AI / Market APIs
GEMINI_API_KEY=
ALPHA_VANTAGE_KEY=

# Market data providers
# Primary EOD for individual equities: TejHQ / Tej Bazaar (keyless REST).
EOD_DATA_PROVIDER=tej
# Optional TejHQ free API key unlocks split/dividend adjusted prices and NSE delivery (1,000 requests/day).
TEJ_API_KEY=
# Optional EOD enrichment: add your BharatStock free API key (60 requests/day).
BHARATSTOCK_API_KEY=
# Secondary: Upstox REST quote snapshots for current-session dashboard prices.
LIVE_DATA_PROVIDER=upstox
UPSTOX_ACCESS_TOKEN=
UPSTOX_INSTRUMENT_KEYS=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank,BSE_INDEX|SENSEX

# Webhook signing secret. Keep this private and never expose it to the frontend.
WEBHOOK_SECRET=change_me_webhook_secret

# CORS
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000"]
