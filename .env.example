# Application
ENV=development
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://mdp_user:mdp_pass@postgres:5432/market_diagnosis

# Redis
REDIS_URL=redis://:redis_pass@redis:6379/0

# AI / Market APIs
GEMINI_API_KEY=
ALPHA_VANTAGE_KEY=

# Webhook signing secret. Keep this private and never expose it to the frontend.
WEBHOOK_SECRET=change_me_webhook_secret

# CORS
ALLOWED_ORIGINS=["http://localhost","http://localhost:3000"]
